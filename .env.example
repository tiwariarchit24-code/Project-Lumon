# Copy this file to .env.local and fill in values.
# .env.local is ignored by Git. Never commit real keys.

# connected = staging/refresh commands may use the network
# airgapped = no external network requests at all (default)
LUMON_MODE=airgapped

# Optional keys for sources that require registration.
# Leave empty to keep those sources disabled.
NASA_FIRMS_MAP_KEY=
OPENAQ_API_KEY=
AISSTREAM_API_KEY=

# --- OpenSky aircraft (optional) -------------------------------------------
# Without these, aircraft refresh anonymously and only on demand
# (400 credits/day; an India-wide query costs 4 credits).
# API client from https://opensky-network.org/my-opensky/account
# (OAuth2 client credentials; username/password no longer works).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# OpenSky's terms require a prior WRITTEN AGREEMENT for any automated or
# operational REST use (contact@opensky-network.org). Set to "yes" only once
# that agreement exists; only then does Lumon poll automatically.
OPENSKY_AGREEMENT_CONFIRMED=
# Daily credit budget used to space the polls (4000 = standard API client).
OPENSKY_DAILY_CREDITS=4000
