# Dependencies installed by npm
node_modules/

# Production build output
dist/

# Logs
npm-debug.log*
*.log

# Editor and operating system files
.DS_Store
.vscode/
.idea/

# Local environment files (never commit secrets)
.env
.env.*
# ...but the example file (placeholder names only) is meant to be committed.
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Staged data, snapshots, imagery and the local database.
# These are reproduced with the staging commands (see docs/ingestion.md)
# and must never be committed.
data/
.vercel
.env*
